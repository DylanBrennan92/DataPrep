<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level){ERROR=red, WARN=yellow, INFO=green, DEBUG=blue} %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress ERROR when PermittedHeadersBuilder intentionally loads a non-existent file -->
    <logger name="com.originspecs.dataprep.config.PermittedHeadersBuilder" level="OFF" />

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
